# Copiar este archivo como .env y completar los valores

# Puerto de la API
PORT=3000

# Origen del cliente React (Vite). CORS solo acepta pedidos de acá
FRONTEND_URL=http://localhost:5173

# Conexión a MySQL (el usuario lo crea database/schema.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=biblioteca_app
DB_PASSWORD=una-clave-segura
DB_NAME=biblioteca

# Clave para firmar los tokens JWT: un texto largo y secreto
JWT_SECRET=cambiar-por-un-texto-largo-y-secreto
